  "cues": [
    {"sceneId":"scene-01","texts":["Warum schließen Länder Bündnisse?","Einfach erklärt"]},
    {"sceneId":"scene-02","texts":["Ein Staat allein kann","militärisch, wirtschaftlich oder politisch","schwächer sein als mehrere gemeinsam"]},
    {"sceneId":"scene-03","texts":["In einem Bündnis versprechen Länder","ihre Kräfte und ihren Einfluss","miteinander zu verbinden"]},
    {"sceneId":"scene-04","texts":["Bei einem Verteidigungsbündnis","könnte ein Angriff","mehrere Staaten auf den Plan rufen"]},
    {"sceneId":"scene-05","texts":["Diese Aussicht kann abschrecken","weil Risiko und Kosten","deutlich steigen"]},
    {"sceneId":"scene-06","texts":["Mitglieder planen gemeinsame Übungen","stimmen Ausrüstung ab","und tauschen Informationen aus"]},
    {"sceneId":"scene-07","texts":["Andere Bündnisse konzentrieren sich","auf Handel, Forschung","oder politischen Einfluss"]},
    {"sceneId":"scene-08","texts":["So können Staaten Kosten teilen","Fachwissen bündeln","und ihre Stimme verstärken"]},
    {"sceneId":"scene-09","texts":["Doch ein Bündnis ist","kein kostenloser Schutzschild","Mitglieder müssen etwas beitragen"]},
    {"sceneId":"scene-10","texts":["Mitglieder können unter Druck geraten","Partner in Konflikten zu unterstützen","die sie selbst vermeiden wollten"]},
    {"sceneId":"scene-11","texts":["Verträge legen fest","wann Hilfe gilt, wer entscheidet","und welche Pflichten bestehen"]},
    {"sceneId":"scene-12","texts":["Die entscheidende Frage lautet","Macht das Bündnis sicherer","oder schafft es neue Abhängigkeiten?"]},
    {"sceneId":"scene-13","texts":["Bündnisse geben mehr Gewicht","und mehr Schutz","dafür sinkt völlige Handlungsfreiheit"]}
  ]
}
