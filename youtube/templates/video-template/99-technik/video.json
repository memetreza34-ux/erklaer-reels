{
  "schemaVersion": 4,
  "productionRulesVersion": 2,
  "videoId": "YYYY-KWNN_topic-slug",
  "weekFolder": "YYYY-KWNN_DD-MM_bis_DD-MM",
  "topicSlug": "topic-slug",
  "title": "",
  "topic": "",
  "status": "planned",
  "language": "de",
  "format": "youtube-longform",
  "visualStyleId": "youtube-editorial-stick-explainer",
  "visualStyleReason": "Feste YouTube-Bildwelt: hand-drawn editorial stick-figure explainer style für erzählerische Langvideos.",
  "targetDurationMinutes": {
    "min": 10,
    "max": 12,
    "mode": "approximate"
  },
  "plannedImageCount": {
    "mode": "adaptive",
    "guidanceMin": 50,
    "guidanceMax": 90,
    "guidanceOnly": true,
    "fixedTargetForbidden": true
  },
  "adaptivePacing": {
    "typicalHoldSeconds": [5, 12],
    "calmHoldSecondsMax": 14,
    "reviewFromSeconds": 14,
    "strongSplitReviewFromSeconds": 16,
    "hardMaximumExclusiveSeconds": 20,
    "reviewIfShorterThanSeconds": 4,
    "normallyForbiddenShorterThanSeconds": 2,
    "oneImageOneVisualPurpose": true,
    "imageCountMustFollowContentDensity": true,
    "uniformHoldDistributionForbidden": true
  },
  "scriptAudioParts": {
    "enabled": true,
    "imagesPerPart": 10,
    "scriptMasterFile": "01-voice-script/voice-script.txt",
    "scriptPartPattern": "01-voice-script/NN_part-bilder-XX-bis-YY.txt",
    "audioPartPattern": "02-audio/NN_part-bilder-XX-bis-YY.<audio>",
    "noTextGaps": true,
    "noTextOverlaps": true,
    "partBoundaryMustBeNatural": true,
    "maxUnplannedGapBetweenAudioPartsSeconds": 0.25
  },
  "titleRequired": true,
  "thumbnailRequired": true,
  "topicDuplicateCheckRequired": true,
  "folderRule": "youtube/<weekFolder>/<topicSlug>/",
  "createdAt": "",
  "updatedAt": ""
}
