# Die MP3s unter assets/sfx/ sind selbst erzeugt (scripts/generate-sfx.js) und
# bewusst eingecheckt. Ausgeschlossen bleiben nur die WAV-Zwischenstufen des
# Generators und die Kopien, die beim Timeline-Bau in die Reels wandern.
assets/sfx/*.wav
reels/**/sfx/
ki_app_script.txt

# Finder-Komfort-Symlinks aus src/core/human-reel-view.js.
