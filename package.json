{
  "name": "erklaer-reels",
  "version": "0.23.3",
  "private": true,
  "type": "module",
  "description": "KI-gestützte Produktionspipeline für visuelle Erklär-Reels.",
  "scripts": {
    "next:slot": "node src/cli/next-reel-slot.js",
    "create:reel": "node src/cli/create-reel.js",
    "prepare:reel": "node src/cli/prepare-reel.js",
    "export:prompts": "node src/cli/export-image-prompts.js",
    "check:content": "node src/cli/check-content.js",
    "check:visuals": "node src/cli/check-visuals.js",
    "finalize:reel": "node src/cli/finalize-reel.js",
    "status:reel": "node src/cli/reel-status.js",
    "validate:reel": "node src/cli/validate-reel.js",
    "validate:render": "node src/cli/render-reel.js --validate-only",
    "discover:assets": "node src/cli/discover-assets.js",
    "organize:assets": "node src/cli/organize-assets.js",
    "organize:finder": "node src/cli/organize-finder.js",
    "trim:pauses": "node src/cli/trim-pauses.js",
    "build:timeline": "node src/cli/build-timeline.js",
    "sync:audio": "node src/cli/build-timeline.js",
    "legacy:sync:words": "node src/cli/sync-words.js",
    "render:reel": "node src/cli/render-reel.js",
    "studio": "remotion studio src/renderer/index.jsx",
    "test": "node --test",
    "hooks:install": "git config core.hooksPath scripts/hooks",
    "prepare": "git config core.hooksPath scripts/hooks || true"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.500",
    "@remotion/cli": "4.0.500",
    "@remotion/renderer": "4.0.500",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.500"
  },
  "engines": {
    "node": ">=20"
  }
}
