    {"sceneId":"scene-01","items":[{"text":"Warum haben Länder Grenzen?"},{"text":"Einfach erklärt: Grenzen zeigen,"},{"text":"wo die politische Zuständigkeit"},{"text":"eines Staates beginnt und endet."}]},
    {"sceneId":"scene-02","items":[{"text":"Innerhalb dieses Gebiets gelten"},{"text":"seine Gesetze, Behörden, Steuern"},{"text":"und staatlichen Entscheidungen."}]},
    {"sceneId":"scene-03","items":[{"text":"Solche Linien entstanden aber"},{"text":"nicht auf einmal."}]},
    {"sceneId":"scene-04","items":[{"text":"Manche folgen Flüssen,"},{"text":"Gebirgen oder Küsten."}]},
    {"sceneId":"scene-05","items":[{"text":"Andere wurden nach Kriegen,"},{"text":"Verträgen, Kolonialherrschaft oder dem"},{"text":"Zerfall größerer Reiche festgelegt."}]},
    {"sceneId":"scene-06","items":[{"text":"Deshalb wirken viele Grenzen"},{"text":"auf Karten gerade, obwohl"},{"text":"Landschaften und Bevölkerungsgruppen"},{"text":"nicht so ordentlich verteilt sind."}]},
    {"sceneId":"scene-07","items":[{"text":"Auch Meere besitzen festgelegte Zonen,"},{"text":"in denen Staaten bestimmte Rechte"},{"text":"über Rohstoffe und Schifffahrt ausüben."}]},
    {"sceneId":"scene-08","items":[{"text":"Eine Staatsgrenze ist außerdem"},{"text":"nicht immer eine Mauer."}]},
    {"sceneId":"scene-09","items":[{"text":"In Europa kann man viele"},{"text":"Grenzen fast unbemerkt überqueren,"},{"text":"während andere streng kontrolliert werden."}]},
    {"sceneId":"scene-10","items":[{"text":"Grenzen können Sicherheit und"},{"text":"Verwaltung ermöglichen, aber auch"},{"text":"Familien, Handelsräume und kulturell"},{"text":"verbundene Regionen trennen."}]},
    {"sceneId":"scene-11","items":[{"text":"Entscheidend ist deshalb nicht nur,"},{"text":"wo eine Linie verläuft, sondern"},{"text":"wie Staaten mit ihr umgehen."}]},
    {"sceneId":"scene-12","items":[{"text":"Frag dich bei jeder Grenze:"},{"text":"Wer hat sie festgelegt,"},{"text":"und wen verbindet oder trennt"},{"text":"sie bis heute?"}]},
    {"sceneId":"scene-13","items":[{"text":"Karten zeigen Linien."},{"text":"Ihre Bedeutung entsteht durch Geschichte,"},{"text":"Macht und politische Entscheidungen."}]}
  ]
}
