{
  "motionEffects": {
    "defaultEnabled": true,
    "defaultType": "none",
    "allowedTypes": [
      "none",
      "slow-zoom-in",
      "slow-zoom-out",
      "subtle-push-in",
      "subtle-pull-out",
      "pan-left",
      "pan-right",
      "pan-up",
      "pan-down"
    ],
    "zoomScale": {
      "min": 0.92,
      "max": 1.08,
      "recommendedChangeMin": 0.02,
      "recommendedChangeMax": 0.06
    },
    "maximumPanPercent": 4,
    "defaultEasing": "ease-in-out",
    "avoidMotionOnEveryScene": true,
    "protectSubtitleSafeZone": true,
    "protectIntegratedImageText": true
  },
  "transitions": {
    "defaultType": "cut",
    "allowedTypes": [
      "none",
      "cut"
    ],
    "directCutOnly": true,
    "allowCrossfade": false,
    "allowDipToDark": false,
    "allowSlides": false,
    "forbidBlackFrames": true,
    "hookTransition": "none",
    "allFollowingScenes": "cut"
  },
  "soundEffects": {
    "defaultEnabled": true,
    "backgroundMusicDefaultEnabled": false,
    "voiceoverHasPriority": true,
    "maximumPerScene": 2,
    "recommendedVolume": {
      "min": 0.12,
      "max": 0.3,
      "default": 0.2
    },
    "allowedCategories": [
      "whoosh-soft",
      "pop-soft",
      "click",
      "tick",
      "impact-soft",
      "paper",
      "notification-soft",
      "ambient-light",
      "object-specific"
    ],
    "avoidSoundOnEveryCut": true,
    "avoidMemeSounds": true,
    "avoidCopyrightedMusic": true,
    "syncToAudioCueOrVisualEvent": true
  }
}
