{
  "version": 5,
  "assetMatching": {
    "minimumConfidence": 0.9,
    "requireVisualReview": true,
    "requireSecondPassConfirmation": true,
    "requireSceneOrderConfirmation": true,
    "requireMatchReason": true,
    "minimumMatchReasonLength": 20,
    "requireVisibleSummary": true,
    "minimumVisibleSummaryLength": 15,
    "requiredSceneComparedFields": [
      "narration",
      "visualIdea",
      "imageText",
      "imagePrompt"
    ],
    "requiredCoverComparedFields": [
      "headline",
      "coverVisualIdea",
      "coverPrompt"
    ],
    "forbidFilenameOnlyMatching": true,
    "allowedMatchMethods": [
      "visual-content-review",
      "visual-text-and-content-review"
    ],
    "leaveUnmatchedWhenUncertain": true
  },
  "sceneTiming": {
    "hookSeconds": {
      "min": 4.5,
      "max": 6.0
    },
    "standardSeconds": {
      "min": 6.0,
      "max": 7.5
    },
    "finalSceneSecondsIncludingHold": {
      "min": 5.8,
      "max": 8.2
    },
    "maximumAdjacentDifferenceSeconds": 2.5,
    "postVoiceHoldSeconds": 0.6,
    "postVoiceHoldRangeSeconds": {
      "min": 0.5,
      "max": 0.7
    },
    "strictTimelineBalance": true,
    "minimumImagePhaseSeconds": 2.2,
    "recommendedImagePhaseSeconds": {
      "min": 2.5,
      "max": 3.8
    },
    "splitReviewThresholdSeconds": 4.8,
    "guidance": "Adaptive-Dense-V2-Reels dürfen mehr Bildphasen besitzen. Inhalt und echte Audio-Cues entscheiden; ab etwa 4,8 Sekunden pro Bild aktiv prüfen, ob ein zusätzlicher sinnvoller Bildmoment nötig ist. Keine starren gleich langen Blöcke."
  },
  "editTiming": {
    "sceneCueLeadSeconds": 0.1,
    "imageCueLeadSeconds": 0.08,
    "sfxPreRollSeconds": 0.04,
    "sceneChangeSfxPreRollSeconds": 0.04,
    "maximumCutLeadSeconds": 0.12,
    "guidance": "Neue Bilder sollen am gesprochenen Cue oder minimal davor erscheinen. Standard: Bildschnitt 0,08 s vor dem Cue; ein kurzer Wechsel-SFX startet weitere 0,04 s davor, sodass sein hörbarer Akzent am Schnitt sitzt."
  },
  "visualContinuity": {
    "requireSceneMeaningMatch": true,
    "requireSceneOrderConfirmed": true,
    "requirePlannedGermanTextExact": true,
    "forbidUnexpectedReadableText": true,
    "requireSingleWorldLock": true,
    "forbidDecorativeTinyBallActors": true,
    "preferSubjectOnlyWhenActorAddsNoMeaning": true
  }
}
