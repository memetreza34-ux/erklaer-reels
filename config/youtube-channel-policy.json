{
  "schemaVersion": 2,
  "visualPolicyVersion": 5,
  "coverPolicyVersion": 1,
  "assetGenerationPolicyVersion": 1,
  "designQualityVersion": 1,
  "adaptivePacingVersion": 3,
  "channelFocus": {
