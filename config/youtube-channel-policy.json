  "imageDensityPolicy": {
    "contentDrivenImageCountRequired": true,
    "fixedImageCountForbidden": true,
    "splitOnNewVisualIdeaRequired": true,
    "splitOnEraLocationPerspectiveChangeRequired": true,
    "splitCauseEffectWhenDense": true,
    "splitLongSimpleHoldPreferred": true,
    "targetAverageHoldSeconds": [4.5, 7.5],
    "softReviewAboveSeconds": 9,
    "strongSplitReviewAboveSeconds": 11,
    "globalHardMaximumSeconds": 16,
    "minimumUsefulHoldSeconds": 2.5,
    "allowMoreImagesWhenNarrativelyUseful": true,
    "doNotAddFillerImages": true
