    "previousGeneratedImageAsReferenceForbidden": true
  },
  "qualityPolicy": {
    "visualStorytellingRequired": true,
    "lifelessStaticCompositionForbidden": true,
    "genericCenteredObjectOnBlankBackgroundForbiddenByDefault": true,
    "genericIconCollageForbidden": true,
    "repeatedLayoutForbiddenWithoutNarrativeReason": true,
    "sceneSpecificArtDirectionRequired": true,
    "countryballVisualWorldRequired": true,
    "perfectlyRoundCountryballActorsRequired": true,
    "normalIllustratedHumansForbidden": true,
    "humanoidCartoonPeopleForbidden": true,
    "stickFiguresForbidden": true,
    "childishCartoonLookForbidden": true,
    "photorealismForbiddenByDefault": true,
    "glossy3dPixarClayAnimeForbidden": true,
    "premiumCompositionRequired": true,
    "intentionalPaletteRequired": true,
    "typographyHierarchyRequiredWhenTextPresent": true,
    "foregroundMidgroundBackgroundDepthPreferred": true,
    "balancedNegativeSpaceRequired": true,
    "mapLegibilityRequired": true,
    "visualRelationshipOverIconListingRequired": true,
    "premiumDoesNotAuthorizeStyleChange": true
