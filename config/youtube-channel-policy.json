{
  "schemaVersion": 3,
  "visualPolicyVersion": 5,
  "coverPolicyVersion": 1,
  "assetGenerationPolicyVersion": 1,
  "designQualityVersion": 1,
  "adaptivePacingVersion": 3,
  "scriptOpeningPolicyVersion": 1,
  "sceneIllustrationPolicyVersion": 2,
  "topicVisualRelevancePolicyVersion": 1,
  "endHoldPolicyVersion": 1,
  "channelFocus": {
    "primaryTopics": [
      "Politik und Staatssysteme",
      "Geschichte",
      "Länder, Geografie, Grenzen und Territorien",
      "Ideologien und Gesellschaftssysteme",
      "internationale Beziehungen und Geopolitik"
    ],
    "adjacentTopicsAllowedOnlyWithClearCoreLink": true,
    "pausedWithoutExplicitUserRequest": [
      "Gesundheit",
      "Medizin",
      "Psychologie",
      "Lifestyle",
      "allgemeine Alltags-Warum-Themen ohne Länder-, Geschichts- oder Systembezug"
    ]
  },
  "scriptOpeningPolicy": {
    "directQuestionRequiredAtStart": true,
    "maxCharactersBeforeFirstQuestionMark": 120,
    "viewerThoughtPhrase": "Denkst du dir gerade vielleicht.",
    "viewerThoughtPhraseRequired": true,
    "shortAnswerRequired": true,
    "shortAnswerMarkers": ["Kurz gesagt:", "Einfach gesagt:"],
    "bridgeQuestionRequired": true,
    "openingWindowCharacters": 420,
    "abstractDefinitionLeadForbidden": true,
    "explicitUserOverrideAllowed": true
  },
  "visualStyleId": "serious-minimal-countryball-explainer-youtube-16x9",
  "sourceVisualWorldId": "serious-minimal-countryball-explainer",
  "coverPolicy": {
    "firstSceneIsCover": true,
    "coverImageNumber": 1,
    "coverMustBeFirstTimelineImage": true,
    "coverMustAlsoBeThumbnailSource": true,
    "separateThumbnailImageForbidden": true,
    "image00ForbiddenForNewProjects": true,
    "coverHeadlineRequired": true
  },
  "assetGenerationPolicy": {
    "coverCandidateCount": 3,
    "coverSelectionRequired": true,
    "selectedCoverFinalName": "Bild 01.png",
    "discardUnselectedCoverCandidates": true,
    "nonCoverGenerationCount": 1,
    "nonCoverManualWaveReviewForbidden": true,
    "nonCoverRegenerationByDefaultForbidden": true,
    "maxConcurrentGenerations": 5,
    "renameEachFinalImageExactlyOnce": true,
    "finalImagesFlatInSingleFolder": true,
    "finalImageDirectory": "00-bildprompts/images",
    "temporaryCoverCandidatesForbiddenInFinalFolder": true
  },
  "sessionPolicy": {
    "freshFlowSessionRequiredWhenVisualPolicyChanges": true,
    "continueSessionContainingLegacyStyleInstructionsForbidden": true,
    "activeStyleIdMustBeRestatedBeforeGeneration": true,
    "previousGeneratedImageAsReferenceForbidden": true
  },
  "qualityPolicy": {
    "visualStorytellingRequired": true,
    "lifelessStaticCompositionForbidden": true,
    "genericCenteredObjectOnBlankBackgroundForbiddenByDefault": true,
    "genericIconCollageForbidden": true,
    "repeatedLayoutForbiddenWithoutNarrativeReason": true,
    "sceneSpecificArtDirectionRequired": true,
    "countryballVisualWorldRequired": true,
    "perfectlyRoundCountryballActorsRequired": true,
    "normalIllustratedHumansForbidden": true,
    "humanoidCartoonPeopleForbidden": true,
    "stickFiguresForbidden": true,
    "childishCartoonLookForbidden": true,
    "photorealismForbiddenByDefault": true,
    "glossy3dPixarClayAnimeForbidden": true,
    "premiumCompositionRequired": true,
    "intentionalPaletteRequired": true,
    "typographyHierarchyRequiredWhenTextPresent": true,
    "foregroundMidgroundBackgroundDepthPreferred": true,
    "balancedNegativeSpaceRequired": true,
    "mapLegibilityRequired": true,
    "visualRelationshipOverIconListingRequired": true,
    "premiumDoesNotAuthorizeStyleChange": true
  },
  "sceneIllustrationPolicy": {
    "concreteIllustratedScenePreferred": true,
    "abstractInfographicPosterForbiddenByDefault": true,
    "multiPanelDashboardForbiddenByDefault": true,
    "iconGridAsPrimaryCompositionForbidden": true,
    "recognizablePlaceOrSituationPreferred": true,
    "actorsShouldDoSomethingWhenActorsAreUseful": true,
    "sceneBasedColorVariationRequired": true,
    "textMustSupportSceneNotReplaceScene": true
  },
  "topicVisualRelevancePolicy": {
    "eachImageMustBeSpecificToVideoTopic": true,
    "sentenceAndTopicDualMatchRequired": true,
    "topicAnchorRequiredPerImagePlan": true,
    "interchangeableGenericSceneForbidden": true,
    "genericMetaphorForbiddenWhenTopicSpecificSceneExists": true,
    "arbitraryCountryOrFlagUseForbidden": true,
    "countryOrFlagRequiresNarrativeReason": true,
    "topicSpecificInstitutionsObjectsPlacesPreferred": true,
    "finalImageMustSummarizeCoreTopicNotGenericMoral": true
  },
  "endHoldPolicy": {
    "lastImageMustRemainVisibleAfterLastWord": true,
    "minimumSeconds": 1.2,
    "targetSeconds": 1.3,
    "maximumSeconds": 1.5,
    "audioSilenceMustNotBeUsedAsSubstitute": true
  },
  "imageDensityPolicy": {
    "contentDrivenImageCountRequired": true,
    "fixedImageCountForbidden": true,
    "splitOnNewVisualIdeaRequired": true,
    "splitOnEraLocationPerspectiveChangeRequired": true,
    "splitCauseEffectWhenDense": true,
    "splitLongSimpleHoldPreferred": true,
    "targetAverageHoldSeconds": [4.5, 7.5],
    "softReviewAboveSeconds": 9,
    "strongSplitReviewAboveSeconds": 11,
    "globalHardMaximumSeconds": 16,
    "minimumUsefulHoldSeconds": 2.5,
    "allowMoreImagesWhenNarrativelyUseful": true,
    "doNotAddFillerImages": true
  },
  "preferredCompositionModes": [
    "minimal-symbolic",
    "supported-explainer",
    "simple-mini-scene",
    "map-spatial-explainer",
    "conceptual-metaphor",
    "before-after",
    "cause-effect",
    "route-progression"
  ]
}
