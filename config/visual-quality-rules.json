{
  "version": 8,
  "composition": {
    "width": 1080,
    "height": 1920,
    "aspectRatio": "9:16",
    "aspectRatioTolerance": 0.015,
    "minimumWidth": 720,
    "minimumHeight": 1280
  },
  "supportedFormats": ["png", "jpg", "jpeg", "webp"],
  "safeZones": {
    "leftPercent": 6,
    "rightPercent": 6,
    "topPercent": 8,
    "bottomPercent": 18,
    "subtitleVerticalPercent": {
      "min": 58,
      "max": 58,
      "default": 58
    }
  },
  "subtitlePalette": {
    "textColor": "#F5F7FA",
    "highlightColor": "#B7794A",
    "highlightCurrentWord": true,
    "speakerSyncedWordHighlight": true,
    "completeSpokenTextCoverageRequired": true,
    "backgroundColor": "transparent",
    "textStrokeColor": "rgba(0, 0, 0, 0.92)"
  },
  "manualChecksByKind": {
    "scene": [
      "sceneMeaningMatchesNarration",
      "sceneMatchesVisualIdea",
      "sceneOrderConfirmed",
      "visualWorldMatch",
      "characterModelConsistent",
      "mainSubjectSafe",
      "naturalContinuousComposition",
      "oneClearMoment",
      "noRepeatedMainCharacter",
      "noArtificialCenterGap",
      "plannedGermanTextExact",
      "noUnexpectedReadableText",
      "subtitleCollisionFree",
      "subtitleReadableWithoutBox",
      "platformUiSafe",
      "motionSafe",
      "styleConsistent"
    ],
    "cover": [
      "coverMatchesTopic",
      "headlineExactAndReadable",
      "visualWorldMatch",
      "mainSubjectSafe",
      "naturalContinuousComposition",
      "noArtificialCenterGap",
      "noUnexpectedReadableText",
      "platformUiSafe",
      "styleConsistent"
    ]
  },
  "manualEvidence": {
    "requireVisibleSummary": true,
    "minimumVisibleSummaryLength": 15,
    "requireMatchReason": true,
    "minimumMatchReasonLength": 20,
    "requireComparedAssetId": true,
    "requireSecondPassConfirmationForScenes": true
  },
  "strictMode": {
    "requireAllAssets": true,
    "requireReadableMetadata": true,
    "requireMinimumResolution": true,
    "requireManualReviewPassed": true,
    "requireSemanticSceneVerification": true
  }
}
