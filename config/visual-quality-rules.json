{
  "version": 11,
  "composition": {
    "width": 1080,
    "height": 1920,
    "aspectRatio": "9:16",
    "aspectRatioTolerance": 0.015,
    "minimumWidth": 720,
    "minimumHeight": 1280
  },
  "supportedFormats": ["png", "jpg", "jpeg", "webp"],
  "safeZones": {
    "leftPercent": 6,
    "rightPercent": 6,
    "topPercent": 8,
    "bottomPercent": 18
  },
  "subtitlesEnabled": false,
  "manualChecksByKind": {
    "scene": [
      "sceneMeaningMatchesNarration",
      "sceneMatchesVisualIdea",
      "sceneOrderConfirmed",
      "visualWorldMatch",
      "goldenReferenceCountryballMatch",
      "perfectCircularCharacterGeometry",
      "fullMainBallSilhouetteVisible",
      "countryballEyesOnlyNoHumanFace",
      "noFurnitureHeadOcclusion",
      "noSkinToneHumanHeadLook",
      "noOvalEggBeanHumanoidCharacters",
      "characterModelConsistent",
      "mainSubjectSafe",
      "naturalContinuousComposition",
      "oneClearMoment",
      "noRepeatedMainCharacter",
      "noArtificialCenterGap",
      "plannedGermanTextExact",
      "noUnexpectedReadableText",
      "platformUiSafe",
      "motionSafe",
      "styleConsistent"
    ],
    "cover": [
      "coverMatchesTopic",
      "headlineExactAndReadable",
      "visualWorldMatch",
      "goldenReferenceCountryballMatch",
      "perfectCircularCharacterGeometry",
      "fullMainBallSilhouetteVisible",
      "countryballEyesOnlyNoHumanFace",
      "noFurnitureHeadOcclusion",
      "noSkinToneHumanHeadLook",
      "noOvalEggBeanHumanoidCharacters",
      "characterModelConsistent",
      "mainSubjectSafe",
      "naturalContinuousComposition",
      "noArtificialCenterGap",
      "noUnexpectedReadableText",
      "platformUiSafe",
      "styleConsistent"
    ]
  },
  "characterGeometry": {
    "requiredVisualWorld": "round-country-characters",
    "goldenReferenceFile": "knowledge/countryball-style-master.md",
    "bodyShape": "perfect-geometric-circle",
    "equalVisibleWidthAndHeight": true,
    "sameGeometryForCountryAndNonCountryCharacters": true,
    "fullMainBallSilhouetteVisible": true,
    "eyesDirectlyOnCircle": true,
    "eyesStyle": "two-simple-white-countryball-eyes-only",
    "mouthAllowed": false,
    "noseAllowed": false,
    "earsAllowed": false,
    "hairAllowed": false,
    "humanFacialAnatomyAllowed": false,
    "forbidSeparateHeadNeckTorsoShouldersWaist": true,
    "forbidFurnitureOcclusionThatCreatesHeadLook": true,
    "defaultNonCountrySkinToneAllowed": false,
    "nonCountrySurface": "bold-flat-editorial-color-or-simple-two-tone-panel-pattern",
    "forbiddenVisibleShapes": [
      "oval",
      "egg-shaped",
      "bean-shaped",
      "capsule-shaped",
      "pear-shaped",
      "teardrop-shaped",
      "humanoid-body",
      "ball-as-human-head"
    ],
    "poseMayDeformCircle": false
  },
  "manualEvidence": {
    "requireVisibleSummary": true,
    "minimumVisibleSummaryLength": 15,
    "requireMatchReason": true,
    "minimumMatchReasonLength": 20,
    "requireComparedAssetId": true,
    "requireSecondPassConfirmationForScenes": true
  },
  "strictMode": {
    "requireAllAssets": true,
    "requireReadableMetadata": true,
    "requireMinimumResolution": true,
    "requireManualReviewPassed": true,
    "requireSemanticSceneVerification": true
  }
}
