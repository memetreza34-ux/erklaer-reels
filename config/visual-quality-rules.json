{
  "version": 16,
  "composition": {
    "width": 1080,
    "height": 1920,
    "aspectRatio": "9:16",
    "aspectRatioTolerance": 0.015,
    "minimumWidth": 1080,
    "minimumHeight": 1920,
    "nativeResolutionHardGateSince": "2026-09-19"
  },
  "supportedFormats": ["png", "jpg", "jpeg", "webp"],
  "safeZones": {
    "leftPercent": 6,
    "rightPercent": 6,
    "topPercent": 8,
    "bottomPercent": 18
  },
  "subtitlesEnabled": false,
  "backgroundPalette": {
    "hardGateSince": "2026-09-19",
    "maximumDeltaE": 12,
    "colours": [
      { "name": "Tiefes Navy", "hex": "#222C4C" },
      { "name": "Warmes Creme", "hex": "#FAF3DC" },
      { "name": "Schiefer-Blaugrau", "hex": "#8A9FA6" },
      { "name": "Gedaempftes Salbei", "hex": "#8AB0A8" },
      { "name": "Warmer Ton", "hex": "#A08878" }
    ],
    "guidance": "Die Hintergrundfarbe jedes Bildes wird am Bildrand gemessen und gegen die feste Palette geprueft. Die Werte stammen aus den Toenen, die das Bildmodell nachweislich trifft: Im Vetorecht-Reel lagen 14 von 21 Bildern bereits innerhalb, die 7 Ausreisser (Lachs, Oliv, Violett, Hellblau, Rosa) darueber."
  },
  "renderedImageText": {
    "hardGateSince": "2026-09-19",
    "verifyPlannedTextIsVisible": true,
    "warnOnUnplannedText": true,
    "guidance": "Der geplante deutsche Bildtext wird per OCR im gelieferten Bild nachgewiesen, nicht nur im Prompt. Ein Bild mit abweichender Headline ist ein Hard Fail, auch wenn Prompt und Plan stimmen."
  },
  "manualChecksByKind": {
    "scene": [
      "sceneMeaningMatchesNarration",
      "sceneOrderConfirmed",
      "visualWorldConsistent",
      "plannedGermanTextExact"
    ],
    "cover": [
      "coverMatchesTopic",
      "visualWorldConsistent",
      "headlineExactAndReadable"
    ]
  },
  "manualEvidence": {
    "requireVisibleSummary": false,
    "minimumVisibleSummaryLength": 0,
    "requireMatchReason": false,
    "minimumMatchReasonLength": 0,
    "requireComparedAssetId": false,
    "requireSecondPassConfirmationForScenes": false
  },
  "strictMode": {
    "requireAllAssets": true,
    "requireReadableMetadata": true,
    "requireMinimumResolution": true,
    "requireManualReviewPassed": false,
    "requireSemanticSceneVerification": false,
    "blockOnExplicitVisualRejection": true
  },
  "autopilotVisualQc": {
    "mode": "single-pass-fast",
    "secondPassForbiddenAsDefault": true,
    "writtenEvidenceNotRequired": true,
    "sequenceIsAuthoritativeWhenFileNumbersAreComplete": true,
    "agentSpotCheckRequired": true,
    "hardFailures": [
      "missing-image",
      "corrupt-or-unreadable-image",
      "wrong-aspect-ratio",
      "wrong-image-number-or-order",
      "obvious-content-mismatch",
      "obvious-visual-world-break",
      "wrong-required-german-text"
    ]
  }
}
