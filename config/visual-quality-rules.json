{
  "version": 5,
  "composition": {
    "width": 1080,
    "height": 1920,
    "aspectRatio": "9:16",
    "aspectRatioTolerance": 0.015,
    "minimumWidth": 720,
    "minimumHeight": 1280
  },
  "supportedFormats": ["png", "jpg", "jpeg", "webp"],
  "safeZones": {
    "leftPercent": 6,
    "rightPercent": 6,
    "topPercent": 8,
    "bottomPercent": 18,
    "subtitleVerticalPercent": {
      "min": 50,
      "max": 50,
      "default": 50
    }
  },
  "subtitlePalette": {
    "textColor": "#F5F7FA",
    "highlightColor": "#F5F7FA",
    "highlightCurrentWord": false,
    "backgroundColor": "transparent",
    "textStrokeColor": "rgba(0, 0, 0, 0.92)"
  },
  "manualChecks": [
    "mainSubjectSafe",
    "naturalContinuousComposition",
    "oneClearMoment",
    "noRepeatedMainCharacter",
    "noArtificialCenterGap",
    "textReadable",
    "textAccurate",
    "noUnrequestedReadableText",
    "subtitleCollisionFree",
    "subtitleReadableWithoutBox",
    "platformUiSafe",
    "motionSafe",
    "styleConsistent"
  ],
  "strictMode": {
    "requireAllAssets": true,
    "requireReadableMetadata": true,
    "requireMinimumResolution": true,
    "requireManualReviewPassed": true
  }
}
