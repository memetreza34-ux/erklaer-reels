{
  "allowedTopics": [
    "Politik und Gesellschaft",
    "Länder, Geografie und Geschichte",
    "Psychologie und menschliches Verhalten"
  ],
  "excludedTopics": [
    "Körper und Biologie",
    "Finanzen",
    "Elektrotechnik",
    "KI-News",
    "tägliche politische Nachrichten",
    "Parteienwerbung"
  ],
  "topicFocus": {
    "statement": "Warum Menschen, Länder und Gesellschaften so funktionieren.",
    "autonomousSelectionLimitedToAllowedTopics": true,
    "bodyAndBiologyExcludedAsContentPillar": true
  },
  "hookRules": {
    "preferredPattern": "THEMA einfach erklärt:",
    "purpose": "Das Thema sofort klar nennen und direkt verständlich erklären, statt künstlich dramatisch oder rätselhaft zu beginnen.",
    "firstSeconds": {
      "topicNamedImmediately": true,
      "plainLanguageRequired": true,
      "answerBeginsImmediately": true,
      "maximumIntroWordsBeforeExplanation": 5
    },
    "tone": [
      "klar",
      "direkt",
      "erwachsen",
      "neutral",
      "leicht verständlich"
    ],
    "preferredExamples": [
      "Sozialismus einfach erklärt:",
      "Demokratie einfach erklärt:",
      "Gruppendruck einfach erklärt:",
      "Warum haben Länder Grenzen? Einfach erklärt:"
    ],
    "avoid": [
      "Heute erkläre ich dir ...",
      "Hast du dich schon einmal gefragt ...",
      "In diesem Video geht es um ...",
      "unnötig dramatische Behauptungen",
      "Clickbait ohne direkte Erklärung",
      "lange Einleitungen vor dem eigentlichen Thema"
    ],
    "alternateHookAllowed": true,
    "alternateHookCondition": "Nur verwenden, wenn eine andere kurze Formulierung das Thema noch klarer eröffnet."
  },
  "scriptRules": {
    "singleNarrator": true,
    "language": "de",
    "simpleExplanations": true,
    "strongImmediateHook": true,
    "avoidSchoolLikeIntro": true,
    "avoidPoliticalEndorsement": true,
    "stateUncertaintyClearly": true,
    "targetDurationSeconds": {
      "min": 35,
      "max": 55
    },
    "maximumSentencePauseSeconds": 0.24,
    "preferredSentencePauseSeconds": 0.1,
    "audioPacing": {
      "requiredBeforeTimeline": true,
      "command": "npm run trim:pauses",
      "silenceThresholdDb": -35,
      "minimumPauseToTightenSeconds": 0.24,
      "retainedPauseFilterSeconds": 0.05,
      "playbackRate": 1.05,
      "preservePitch": true,
      "rerunTimelineAfterward": true,
      "rerunWordSyncAfterward": false
    }
  },
  "visualRules": {
    "minimumSceneCount": 8,
    "maximumSceneCount": 12,
    "sceneCountByDuration": [
      {
        "durationSecondsMin": 35,
        "durationSecondsMax": 44,
        "recommendedScenesMin": 8,
        "recommendedScenesMax": 10
      },
      {
        "durationSecondsMin": 45,
        "durationSecondsMax": 55,
        "recommendedScenesMin": 10,
        "recommendedScenesMax": 12
      }
    ],
    "visualChangeIntervalSeconds": {
      "min": 3.5,
      "max": 5
    },
    "hookVisibleFromSecond": 0,
    "audioCueRequired": true,
    "audioCueLeadSeconds": {
      "min": 0.1,
      "max": 0.3,
      "default": 0.2
    },
    "consistentStyleWithinReel": true,
    "creativeStyleBetweenReels": true,
    "integratedGermanKeywordsAllowed": true,
    "fixedBuildUpRequired": false,
    "naturalContinuousCompositionRequired": true,
    "mainSubjectMayUseCenter": true,
    "forbidArtificialSubtitleGap": true,
    "forbidEmptyHorizontalStripe": true,
    "forbidDisconnectedTopBottomLayout": true,
    "forbidUnrequestedReadableText": true,
    "visibleTextLanguage": "de",
    "noWatermarks": true,
    "noLogosUnlessEditoriallyNecessary": true
  },
  "subtitleRules": {
    "defaultEnabled": true,
    "separateFromImagePrompts": true,
    "position": "lower",
    "verticalPositionPercent": {
      "min": 76,
      "max": 76,
      "default": 76
    },
    "fixedExactLowerPosition": true,
    "palette": {
      "textColor": "#F5F7FA",
      "highlightColor": "#F5F7FA",
      "backgroundColor": "transparent",
      "textStrokeColor": "rgba(0, 0, 0, 0.92)",
      "reason": "Einheitlich weißer Text mit dunkler Kontur bleibt lesbar, ohne die Illustration durch Gelb oder eine schwarze Box zu verdecken."
    },
    "wordsPerCue": {
      "min": 3,
      "max": 6
    },
    "maxLines": 2,
    "wordByWordKaraoke": false,
    "highlightCurrentWord": false,
    "exactWordTimingsRequired": false,
    "wordTimingWorkflow": {
      "enabled": false,
      "reason": "Ohne Wort-Highlight sind aufwendige Einzelwortzeiten für den sichtbaren Untertitel nicht erforderlich."
    },
    "fallbackWordTiming": "plain-soft-white-no-highlight",
    "repeatIntegratedImageText": false,
    "avoidPlatformUiSafeZones": true,
    "avoidExactScreenCenter": true,
    "allowPositionAdjustmentForVisualConflicts": false,
    "doNotCreateBlankBandInImage": true
  }
}
