{
  "allowedTopics": [
    "Psychologie und menschliches Verhalten",
    "Alltag und Gewohnheiten",
    "Beziehungen und soziale Dynamiken",
    "Gesellschaft und Kultur",
    "Geschichte",
    "Länder und Geografie",
    "Politik und staatliche Systeme",
    "Wissenschaft und Naturphänomene",
    "Technik und digitale Welt",
    "Internet und Social Media",
    "Lernen, Schule und Gedächtnis",
    "Arbeit und Beruf",
    "Wirtschaft und Geldmechanismen",
    "Gesundheit und Ernährung",
    "Sprache und Kommunikation",
    "Denkfehler, Mythen und kuriose Warum-Fragen"
  ],
  "excludedTopics": [
    "reine tägliche Breaking-News-Zusammenfassungen",
    "Parteienwerbung oder politische Propaganda",
    "reine Produktwerbung ohne Erklärwert"
  ],
  "topicFocus": {
    "statement": "Das Themenuniversum ist offen. Aktuell ist keine feste Bildwelt definiert.",
    "openTopicUniverse": true,
    "autonomousSelectionLimitedToAllowedTopics": false,
    "allowedTopicsAreExamplesNotHardLimit": true,
    "avoidRepeatedCountryHistoryBias": true,
    "selectionCriteria": [
      "starker Hook und sofortige Neugier",
      "klarer Aha-Moment in unter 60 Sekunden",
      "faktisch sauber erklärbar",
      "visuell stark und klar umsetzbar",
      "abwechslungsreich gegenüber den letzten Reels",
      "teilbar, überraschend oder alltagsrelevant"
    ]
  },
  "hookRules": {
    "preferredPattern": "THEMA einfach erklärt:",
    "purpose": "Das Thema sofort klar nennen und direkt verständlich erklären, statt künstlich dramatisch oder rätselhaft zu beginnen.",
    "firstSeconds": {
      "topicNamedImmediately": true,
      "plainLanguageRequired": true,
      "answerBeginsImmediately": true,
      "maximumIntroWordsBeforeExplanation": 5
    },
    "tone": [
      "klar",
      "direkt",
      "erwachsen",
      "neutral",
      "leicht verständlich"
    ],
    "preferredExamples": [
      "Warum schieben wir Aufgaben auf? Einfach erklärt:",
      "Warum erinnern wir uns falsch? Einfach erklärt:",
      "Warum gehört Alaska zu den USA? Einfach erklärt:",
      "Warum macht Social Media so schnell abhängig? Einfach erklärt:"
    ],
    "avoid": [
      "Heute erkläre ich dir ...",
      "Hast du dich schon einmal gefragt ...",
      "In diesem Video geht es um ...",
      "unnötig dramatische Behauptungen",
      "Clickbait ohne direkte Erklärung",
      "lange Einleitungen vor dem eigentlichen Thema"
    ],
    "alternateHookAllowed": true,
    "alternateHookCondition": "Nur verwenden, wenn eine andere kurze Formulierung das Thema noch klarer und verständlicher eröffnet."
  },
  "scriptRules": {
    "singleNarrator": true,
    "language": "de",
    "simpleExplanations": true,
    "strongImmediateHook": true,
    "avoidSchoolLikeIntro": true,
    "avoidPoliticalEndorsement": true,
    "stateUncertaintyClearly": true,
    "targetDurationSeconds": {
      "min": 55,
      "max": 60,
      "preferred": 58
    },
    "targetWordCount": {
      "min": 155,
      "max": 175,
      "preferred": 165
    },
    "endingRules": {
      "required": true,
      "minimumFinalScenes": 2,
      "structure": [
        "klare persönliche Prüf- oder Erkenntnisfrage",
        "konkrete Handlung oder Lösung",
        "kurzer einprägsamer Abschlusssatz"
      ],
      "avoid": [
        "abruptes Ende direkt nach einer langen Aufzählung",
        "schulische Zusammenfassung ohne Erkenntnis",
        "mehrere Handlungsschritte in einem einzigen überladenen Bild",
        "generischer Aufruf ohne Bezug zum Thema"
      ]
    },
    "maximumSentencePauseSeconds": 0.24,
    "preferredSentencePauseSeconds": 0.1,
    "audioPacing": {
      "requiredBeforeTimeline": true,
      "command": "npm run trim:pauses",
      "silenceThresholdDb": -35,
      "minimumPauseToTightenSeconds": 0.24,
      "retainedPauseFilterSeconds": 0.05,
      "playbackRate": 1.1,
      "preservePitch": true,
      "loudnessNormalization": {
        "enabled": true,
        "integratedLufs": -16,
        "truePeakDbtp": -1.5,
        "loudnessRangeLra": 11
      },
      "rerunTimelineAfterward": true,
      "rerunWordSyncAfterward": false
    }
  },
  "visualRules": {
    "minimumSceneCount": 12,
    "maximumSceneCount": 14,
    "defaultSceneCount": 13,
    "sceneCountByDuration": [
      {
        "durationSecondsMin": 55,
        "durationSecondsMax": 60,
        "recommendedScenesMin": 12,
        "recommendedScenesMax": 14
      }
    ],
    "visualChangeIntervalSeconds": {
      "min": 3.5,
      "max": 5
    },
    "hookVisibleFromSecond": 0,
    "audioCueRequired": true,
    "audioCueLeadSeconds": {
      "min": 0.1,
      "max": 0.3,
      "default": 0.2
    },
    "consistentStyleWithinReel": false,
    "creativeStyleBetweenReels": true,
    "visualWorldMode": "unassigned",
    "fixedVisualWorld": null,
    "selectVisualWorldAfterScript": false,
    "integratedGermanKeywordsAllowed": true,
    "integratedGermanTextPreferred": true,
    "embeddedTextRules": {
      "useWheneverItImprovesClarity": true,
      "language": "de",
      "preferredSceneCoveragePercent": {
        "min": 55,
        "max": 85
      },
      "preferredWordsPerScene": {
        "min": 1,
        "max": 5
      },
      "size": "contextual-small-medium-or-large",
      "allowedUses": [
        "kurze Überschrift",
        "ein einzelnes Schlüsselwort",
        "kleines Schild oder Etikett",
        "Beschriftung auf Dokument, Karte, Display oder Gegenstand",
        "kurze Schlussaussage"
      ],
      "mustAppearExactlyInPrompt": true,
      "mayBeOmittedWhen": "Text würde die Szene überladen oder die Bildgenerierung unnötig verschlechtern.",
      "forbidden": [
        "englischer sichtbarer Text",
        "zufällige oder erfundene Wörter",
        "lange Absätze",
        "unnötig viel Text",
        "erzwungener Text in jeder einzelnen Szene",
        "Workflow-Labels wie BILD, COVER, SZENE oder DATEINAME"
      ]
    },
    "fixedBuildUpRequired": false,
    "naturalContinuousCompositionRequired": true,
    "oneClearMomentPerScene": true,
    "useFullFrameComposition": true,
    "reserveSubtitleSafeZone": false,
    "forbidArtificialSubtitleGap": true,
    "forbidEmptyHorizontalStripe": true,
    "forbidDisconnectedTopBottomLayout": true,
    "forbidOverloadedMultiStepFinalImage": true,
    "forbidUnrequestedReadableText": true,
    "visibleTextLanguage": "de",
    "noWatermarks": true,
    "noLogosUnlessEditoriallyNecessary": true
  },
  "subtitleRules": {
    "defaultEnabled": false,
    "globallyDisabled": true,
    "renderSubtitles": false,
    "generateSubtitleCues": false,
    "wordTimingWorkflowRequired": false,
    "reason": "Globale Nutzerregel: Erklär-Reels werden ohne Untertitel produziert und gerendert."
  }
}
