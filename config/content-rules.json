{
  "allowedTopics": [
    "Politik und Gesellschaft",
    "Länder, Geografie und Geschichte",
    "Psychologie und menschliches Verhalten"
  ],
  "excludedTopics": [
    "Körper und Biologie",
    "Finanzen",
    "Elektrotechnik",
    "KI-News",
    "tägliche politische Nachrichten",
    "Parteienwerbung"
  ],
  "topicFocus": {
    "statement": "Warum Menschen, Länder und Gesellschaften so funktionieren.",
    "autonomousSelectionLimitedToAllowedTopics": true,
    "bodyAndBiologyExcludedAsContentPillar": true
  },
  "hookRules": {
    "preferredPattern": "THEMA einfach erklärt:",
    "purpose": "Das Thema sofort klar nennen und direkt verständlich erklären, statt künstlich dramatisch oder rätselhaft zu beginnen.",
    "firstSeconds": {
      "topicNamedImmediately": true,
      "plainLanguageRequired": true,
      "answerBeginsImmediately": true,
      "maximumIntroWordsBeforeExplanation": 5
    },
    "tone": [
      "klar",
      "direkt",
      "erwachsen",
      "neutral",
      "leicht verständlich"
    ],
    "preferredExamples": [
      "Sozialismus einfach erklärt:",
      "Demokratie einfach erklärt:",
      "Gruppendruck einfach erklärt:",
      "Warum haben Länder Grenzen? Einfach erklärt:"
    ],
    "avoid": [
      "Heute erkläre ich dir ...",
      "Hast du dich schon einmal gefragt ...",
      "In diesem Video geht es um ...",
      "unnötig dramatische Behauptungen",
      "Clickbait ohne direkte Erklärung",
      "lange Einleitungen vor dem eigentlichen Thema"
    ],
    "alternateHookAllowed": true,
    "alternateHookCondition": "Nur verwenden, wenn eine andere kurze Formulierung das Thema noch klarer und verständlicher eröffnet."
  },
  "scriptRules": {
    "singleNarrator": true,
    "language": "de",
    "simpleExplanations": true,
    "strongImmediateHook": true,
    "avoidSchoolLikeIntro": true,
    "avoidPoliticalEndorsement": true,
    "stateUncertaintyClearly": true,
    "targetDurationSeconds": {
      "min": 55,
      "max": 60,
      "preferred": 58
    },
    "targetWordCount": {
      "min": 155,
      "max": 175,
      "preferred": 165
    },
    "endingRules": {
      "required": true,
      "minimumFinalScenes": 2,
      "structure": [
        "klare persönliche Prüf- oder Erkenntnisfrage",
        "konkrete Handlung oder Lösung",
        "kurzer einprägsamer Abschlusssatz"
      ],
      "avoid": [
        "abruptes Ende direkt nach einer langen Aufzählung",
        "schulische Zusammenfassung ohne Erkenntnis",
        "mehrere Handlungsschritte in einem einzigen überladenen Bild",
        "generischer Aufruf ohne Bezug zum Thema"
      ]
    },
    "maximumSentencePauseSeconds": 0.24,
    "preferredSentencePauseSeconds": 0.1,
    "audioPacing": {
      "requiredBeforeTimeline": true,
      "command": "npm run trim:pauses",
      "silenceThresholdDb": -35,
      "minimumPauseToTightenSeconds": 0.24,
      "retainedPauseFilterSeconds": 0.05,
      "playbackRate": 1.1,
      "preservePitch": true,
      "loudnessNormalization": {
        "enabled": true,
        "integratedLufs": -16,
        "truePeakDbtp": -1.5,
        "loudnessRangeLra": 11
      },
      "rerunTimelineAfterward": true,
      "rerunWordSyncAfterward": true
    }
  },
  "visualRules": {
    "minimumSceneCount": 12,
    "maximumSceneCount": 14,
    "defaultSceneCount": 13,
    "sceneCountByDuration": [
      {
        "durationSecondsMin": 55,
        "durationSecondsMax": 60,
        "recommendedScenesMin": 12,
        "recommendedScenesMax": 14
      }
    ],
    "visualChangeIntervalSeconds": {
      "min": 3.5,
      "max": 5
    },
    "hookVisibleFromSecond": 0,
    "audioCueRequired": true,
    "audioCueLeadSeconds": {
      "min": 0.1,
      "max": 0.3,
      "default": 0.2
    },
    "consistentStyleWithinReel": true,
    "creativeStyleBetweenReels": true,
    "selectVisualWorldAfterScript": true,
    "integratedGermanKeywordsAllowed": true,
    "integratedGermanTextPreferred": true,
    "embeddedTextRules": {
      "useWheneverItImprovesClarity": true,
      "language": "de",
      "preferredSceneCoveragePercent": {
        "min": 55,
        "max": 85
      },
      "preferredWordsPerScene": {
        "min": 1,
        "max": 5
      },
      "size": "contextual-small-medium-or-large",
      "allowedUses": [
        "kurze Überschrift",
        "ein einzelnes Schlüsselwort",
        "kleines Schild oder Etikett",
        "Beschriftung auf Dokument, Karte, Display oder Gegenstand",
        "kurze Schlussaussage"
      ],
      "mustAppearExactlyInPrompt": true,
      "mustNotRepeatSubtitleVerbatim": true,
      "mayBeOmittedWhen": "Text würde die Szene überladen, die Aussage doppeln oder die Bildgenerierung unnötig verschlechtern.",
      "forbidden": [
        "englischer sichtbarer Text",
        "zufällige oder erfundene Wörter",
        "lange Absätze",
        "unnötig viel Text",
        "erzwungener Text in jeder einzelnen Szene"
      ]
    },
    "fixedBuildUpRequired": false,
    "naturalContinuousCompositionRequired": true,
    "oneClearMomentPerScene": true,
    "mainSubjectMayUseCenter": true,
    "mainSubjectMayAppearBehindSubtitles": false,
    "protectCriticalFaceDetailsFromSubtitleZone": true,
    "forbidArtificialSubtitleGap": true,
    "forbidEmptyHorizontalStripe": true,
    "forbidDisconnectedTopBottomLayout": true,
    "forbidOverloadedMultiStepFinalImage": true,
    "forbidUnrequestedReadableText": true,
    "visibleTextLanguage": "de",
    "noWatermarks": true,
    "noLogosUnlessEditoriallyNecessary": true
  },
  "subtitleRules": {
    "defaultEnabled": true,
    "separateFromImagePrompts": true,
    "position": "center",
    "verticalPositionPercent": {
      "min": 62,
      "max": 66,
      "default": 64
    },
    "maxWidthPercent": 72,
    "platformTarget": "9:16 TikTok / Instagram Reels / YouTube Shorts",
    "fixedExactCenterPosition": false,
    "fixedVerticalPosition": false,
    "palette": {
      "textColor": "#F5F7FA",
      "highlightColor": "#B7794A",
      "backgroundColor": "transparent",
      "textStrokeColor": "rgba(0, 0, 0, 0.92)",
      "reason": "Weißer Grundtext bleibt auf den Illustrationen gut lesbar; nur das exakt aktuell gesprochene Wort wechselt synchron in ein warmes Braun."
    },
    "wordsPerCue": {
      "min": 3,
      "max": 6
    },
    "maxLines": 2,
    "wordByWordKaraoke": true,
    "highlightCurrentWord": true,
    "speakerSyncedWordHighlight": true,
    "highlightAnimation": "color-only",
    "forbidScaleBounceOrBoxAnimation": true,
    "exactWordTimingsRequired": true,
    "completeSpokenTextCoverageRequired": true,
    "minimumWordCoverage": 1,
    "requireZeroUnassignedWords": true,
    "requireExactVoiceScriptWordSequence": true,
    "wordTimingWorkflow": {
      "enabled": true,
      "provider": "codex-local-audio-review",
      "prepareCommand": "npm run sync:words -- --dir REEL_ORDNER",
      "applyCommand": "npm run sync:words -- --dir REEL_ORDNER --apply --strict",
      "localAudioReviewRequired": true,
      "estimatedDistributionForbidden": true,
      "sceneCueTimingMustAlsoBeVerified": true,
      "rerunAfterAnyAudioEdit": true,
      "reason": "Untertitel und Bildwechsel müssen aus demselben finalen Voice-over abgeleitet werden. Kein gesprochenes Wort und kein Szenenanker darf geschätzt werden."
    },
    "fallbackWordTiming": "blocked-until-codex-word-sync",
    "repeatIntegratedImageText": false,
    "avoidPlatformUiSafeZones": true,
    "allowPositionAdjustmentForVisualConflicts": true,
    "doNotCreateBlankBandInImage": true
  }
}
